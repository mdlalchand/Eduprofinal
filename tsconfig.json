{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "laravel-system",
    "src/components/AcademicOpsPanels.tsx",
    "src/components/AdminDashboardStudio.tsx",
    "src/components/EnterpriseSaasPanel.tsx",
    "src/server/enterpriseRoutes.ts",
    "src/server/enterpriseSeed.ts"
  ]
}
